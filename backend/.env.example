# ── Local Development Environment Variables ─────────────────────────────────
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub — it's in .gitignore.
#
# To use locally:
#   Windows PowerShell:  $env:DATABASE_URL = "postgresql://..."
#   Or use python-dotenv: pip install python-dotenv
#
# ──────────────────────────────────────────────────────────────────────────────

# Supabase connection string (get from Supabase → Settings → Database → URI)
# Use the "Transaction" pooler URL (port 6543) for serverless / Render
DATABASE_URL=postgresql://postgres.YOURPROJECT:YOURPASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
